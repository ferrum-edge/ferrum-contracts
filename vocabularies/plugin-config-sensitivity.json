{
  "$schema": "https://github.com/ferrum-edge/ferrum-contracts/schemas/vocabulary-plugin-config-sensitivity/v1.schema.json",
  "vocabulary": "plugin-config-sensitivity",
  "version": 1,
  "edge_release": "v0.9.21",
  "description": "Which built-in plugin config paths Ferrum Edge treats as credential-bearing, and how it projects each one in a read that withholds secrets (PLUGIN_SENSITIVITY_SCHEMAS), the placeholders it writes in place of withheld values, plus the librdkafka producer properties that stay visible (KAFKA_SAFE_PRODUCER_PROPERTIES). Products that echo or display plugin configs (Foundry, GitForgeOps) use the tables to withhold the same values Edge withholds, and products that read projected configs (Foundry, GitForgeOps, Nexus, Alloy) recognize the placeholders. These schema rules are one layer of Edge's projection: Edge also masks keys by a name heuristic and sweeps URLs and TLS material structurally, which this vocabulary does not transcribe; a custom plugin has no schema rules and Edge withholds every scalar of its config.",
  "provenance": [
    {
      "repo": "ferrum-edge/ferrum-edge",
      "ref": "v0.9.21",
      "commit": "f9915358c8032214f4034a17c28cdf72d14006c3",
      "path": "src/admin/plugin_config_projection.rs",
      "symbols": [
        "FieldSensitivity",
        "SensitivityRule",
        "normalize_config_key",
        "PLUGIN_SENSITIVITY_SCHEMAS",
        "KAFKA_SAFE_PRODUCER_PROPERTIES",
        "REDACTED_PATH_PLACEHOLDER",
        "is_redaction_placeholder",
        "redact_endpoint_url"
      ],
      "note": "Transcribed from the Rust tables at the tag, in source order, with each rule constructor (secret, endpoint_url, redis_url, private_key_source, endpoint_path, certificate_source, or an inline SensitivityRule) resolved to its FieldSensitivity variant and each shared rule set (NONE, REDIS_BACKED, MESH_AUTHZ) expanded in place. Edge's plugin_config_projection_tests require an entry for every built-in in BUILTIN_PLUGIN_PARITY_META."
    },
    {
      "repo": "ferrum-edge/ferrum-edge",
      "ref": "v0.9.21",
      "commit": "f9915358c8032214f4034a17c28cdf72d14006c3",
      "path": "src/plugins/utils/metadata_redaction.rs",
      "symbols": [
        "REDACTED_PLACEHOLDER",
        "REDACTED_USERINFO_PLACEHOLDER",
        "REDACTED_QUERY_PLACEHOLDER",
        "REDACTED_FRAGMENT_PLACEHOLDER"
      ]
    },
    {
      "repo": "ferrum-edge/ferrum-edge",
      "ref": "v0.9.21",
      "commit": "f9915358c8032214f4034a17c28cdf72d14006c3",
      "path": "src/admin/crud.rs",
      "symbols": [
        "masked_placeholder_sites"
      ]
    }
  ],
  "path_matching": "A rule path is applied from the plugin's config object, one segment at a time. At an object, '*' selects every key, and a named segment selects every key whose normalize_config_key spelling equals the segment's (remove '-', '.' and '_', then ASCII-lowercase, on both sides: customHeaders, custom-headers, custom.headers, custom_headers and customheaders are one segment); the rest of the path continues in each selected value. At an array, '*' selects every element and is consumed; a named segment is not consumed and continues into every element, so one rule covers both an object-keyed and an array-shaped container. When the path is exhausted, the rule's sensitivity applies to that value, whatever its type; a null value is left as is. A string, number or boolean met while segments remain cannot be classified and is withheld as Secret (fail closed). path_examples are executable cases of this grammar: each lists every value a rule reaches and the class applied to it. Whether a reached value is then shown depends on its class (an EndpointPath of '' or '/', or a certificate or key reference, stays visible).",
  "path_examples": [
    {
      "description": "A wildcard consumes one array element; sibling fields are not reached.",
      "rule": {
        "path": [
          "providers",
          "*",
          "base_url"
        ],
        "sensitivity": "EndpointUrl"
      },
      "config": {
        "providers": [
          {
            "name": "primary",
            "base_url": "https://api.example.com/v1"
          }
        ]
      },
      "applied": [
        {
          "pointer": "/providers/0/base_url",
          "sensitivity": "EndpointUrl"
        }
      ]
    },
    {
      "description": "A wildcard selects every key of an object.",
      "rule": {
        "path": [
          "headers",
          "*"
        ],
        "sensitivity": "Secret"
      },
      "config": {
        "headers": {
          "x-honeycomb-team": "team-key",
          "Dd-Api-Key": "dd-key"
        }
      },
      "applied": [
        {
          "pointer": "/headers/x-honeycomb-team",
          "sensitivity": "Secret"
        },
        {
          "pointer": "/headers/Dd-Api-Key",
          "sensitivity": "Secret"
        }
      ]
    },
    {
      "description": "A named segment matches any spelling with the same normalize_config_key form.",
      "rule": {
        "path": [
          "custom_headers",
          "*"
        ],
        "sensitivity": "Secret"
      },
      "config": {
        "customHeaders": {
          "X-Token": "t"
        },
        "custom-headers": {
          "X-Other": "o"
        }
      },
      "applied": [
        {
          "pointer": "/customHeaders/X-Token",
          "sensitivity": "Secret"
        },
        {
          "pointer": "/custom-headers/X-Other",
          "sensitivity": "Secret"
        }
      ]
    },
    {
      "description": "A named segment continues into every array element without being consumed.",
      "rule": {
        "path": [
          "channels",
          "url"
        ],
        "sensitivity": "EndpointUrl"
      },
      "config": {
        "channels": [
          {
            "url": "https://a.example/p",
            "name": "a"
          },
          {
            "url": "https://b.example/q",
            "name": "b"
          }
        ]
      },
      "applied": [
        {
          "pointer": "/channels/0/url",
          "sensitivity": "EndpointUrl"
        },
        {
          "pointer": "/channels/1/url",
          "sensitivity": "EndpointUrl"
        }
      ]
    },
    {
      "description": "A scalar met while segments remain is withheld as Secret.",
      "rule": {
        "path": [
          "providers",
          "*",
          "base_url"
        ],
        "sensitivity": "EndpointUrl"
      },
      "config": {
        "providers": "https://api.example.com/v1"
      },
      "applied": [
        {
          "pointer": "/providers",
          "sensitivity": "Secret"
        }
      ]
    },
    {
      "description": "An exhausted path applies to the whole value, whatever its type.",
      "rule": {
        "path": [
          "authorization"
        ],
        "sensitivity": "Secret"
      },
      "config": {
        "Authorization": {
          "scheme": "Bearer",
          "token": "t"
        }
      },
      "applied": [
        {
          "pointer": "/Authorization",
          "sensitivity": "Secret"
        }
      ]
    },
    {
      "description": "A null value is left as is, and keys the path does not name are not reached.",
      "rule": {
        "path": [
          "redis_url"
        ],
        "sensitivity": "RedisUrl"
      },
      "config": {
        "redis_url": null,
        "redis_db": 0
      },
      "applied": []
    }
  ],
  "sensitivities": [
    {
      "value": "Secret",
      "meaning": "Replaced wholesale by the redaction placeholder: credential literals, vendor authentication header values and operator-authored templates."
    },
    {
      "value": "EndpointUrl",
      "meaning": "Projected to scheme://host[:port], with userinfo shown only as the userinfo placeholder, a path marker (/ + placeholders.path) only for a path that is not empty and not /, and query and fragment markers when a query or fragment is present; an unparseable value or one without a host is replaced by the placeholder."
    },
    {
      "value": "RedisUrl",
      "meaning": "Projected through Edge's Redis URL projection (redis://redacted@host:port/db), which keeps the database number."
    },
    {
      "value": "KafkaProducerProperties",
      "meaning": "A librdkafka producer_config map: every value is redacted except the properties in kafka_safe_producer_properties."
    },
    {
      "value": "PrivateKeySource",
      "meaning": "A TLS private-key source: inline key material is replaced by the placeholder, a reference (path, file://, k8s://, vault://, managed://) stays visible, a non-string is withheld."
    },
    {
      "value": "CertificateSource",
      "meaning": "A certificate or CA-bundle source: certificate-only PEM and references stay visible; a value carrying a PEM private-key block, or a non-string, is replaced by the placeholder."
    },
    {
      "value": "EndpointPath",
      "meaning": "An outbound path configured apart from its host and port: an empty path or / stays visible, anything else is replaced by the placeholder, a non-string is withheld."
    }
  ],
  "placeholders": {
    "redacted": "[REDACTED]",
    "userinfo": "redacted",
    "path": "[REDACTED_PATH]",
    "query": "[REDACTED_QUERY]",
    "fragment": "[REDACTED_FRAGMENT]",
    "recognition": "Edge treats a value as its own placeholder (is_redaction_placeholder) only when it is exactly redacted, or parses as a URL whose path is exactly / + path, whose query is exactly query, whose fragment is exactly fragment, or whose username is exactly userinfo with no password. A write is refused when it carries a recognized placeholder at a field the caller's role-specific read projection withholds (masked_placeholder_sites); the same string at a field that projection leaves visible is stored as written."
  },
