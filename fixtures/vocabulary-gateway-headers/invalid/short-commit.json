      "match": "prefix",
      "surface": "proxy",
      "direction": "gateway_to_backend",
      "role": "gateway_assertion",
      "edge_behavior": "Gateway-owned consumer assertion namespace. Consumer plugins may add attributes beneath it, so backend boundaries reject the whole prefix, and it is forbidden in request and response trailers.",
